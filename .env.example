# Token del bot de Telegram, obtenido de @BotFather
TELEGRAM_BOT_TOKEN=

# API key de OpenRouter (https://openrouter.ai/keys). Es gratuita: te
# permite usar varios modelos gratuitos ("...:free") con una sola key.
OPENROUTER_API_KEY=

# Lista de modelos de OpenRouter a usar, en orden de preferencia, separados
# por comas. Si el primero se queda sin cupo gratuito o falla, el bot
# prueba automáticamente con el siguiente. Puedes ver más modelos gratis en
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,deepseek/deepseek-chat:free,mistralai/mistral-small-3.1-24b-instruct:free,qwen/qwen-2.5-72b-instruct:free

# URL pública opcional de tu proyecto (solo para las cabeceras que pide
# OpenRouter, no es obligatorio configurarlo)
OPENROUTER_SITE_URL=https://github.com/Juanda266/Telegram-AI
OPENROUTER_APP_NAME=Telegram AI Assistant

# Lista opcional de IDs de usuario de Telegram autorizados a usar el bot,
# separados por comas. Si se deja vacío, cualquiera puede usarlo.
ALLOWED_TELEGRAM_USER_IDS=

# Cantidad de mensajes previos (por chat) que se envían como contexto al modelo
MAX_HISTORY_MESSAGES=20

# Máximo de pasos de razonamiento/búsqueda que el agente puede dar antes de
# responder (evita bucles infinitos de búsqueda)
MAX_AGENT_STEPS=6

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
