# ─────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────
# Token del bot de Telegram, obtenido de @BotFather
TELEGRAM_BOT_TOKEN=

# Lista opcional de IDs de usuario de Telegram autorizados a usar el bot,
# separados por comas. Si se deja vacío, cualquiera puede usarlo.
ALLOWED_TELEGRAM_USER_IDS=

# ─────────────────────────────────────────────────────────────
# IA (OpenRouter)
# ─────────────────────────────────────────────────────────────
# API key de OpenRouter (https://openrouter.ai/keys). Es gratuita: te
# permite usar varios modelos gratuitos ("...:free") con una sola key.
OPENROUTER_API_KEY=

# Lista de modelos de OpenRouter a usar, en orden de preferencia, separados
# por comas. Si el primero se queda sin cupo gratuito o falla, el bot
# prueba automáticamente con el siguiente. Más modelos gratis en
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,deepseek/deepseek-chat:free,mistralai/mistral-small-3.1-24b-instruct:free,qwen/qwen-2.5-72b-instruct:free

# Cabeceras opcionales que OpenRouter usa para atribuir el tráfico
OPENROUTER_SITE_URL=https://github.com/Juanda266/Telegram-AI
OPENROUTER_APP_NAME=Telegram AI Assistant

# Cantidad de mensajes previos (por chat) que se envían como contexto al modelo
MAX_HISTORY_MESSAGES=20

# Máximo de pasos de razonamiento/búsqueda que el agente puede dar antes de
# responder (evita bucles infinitos de búsqueda)
MAX_AGENT_STEPS=6

# ─────────────────────────────────────────────────────────────
# Facturación (Stripe) — opcional
# ─────────────────────────────────────────────────────────────
# Pon BILLING_ENABLED=true para activar el plan gratuito limitado + Premium.
# Si lo dejas en false, el bot es ilimitado para todos.
BILLING_ENABLED=false

# Mensajes gratis por usuario y por día en el plan gratuito
FREE_DAILY_MESSAGES=15

# Texto que se muestra al usuario al ofrecerle el plan (solo informativo)
PREMIUM_PRICE_LABEL=5 USD/mes

# Credenciales de Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhooks (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=
# ID del precio recurrente creado en Stripe (empieza por price_...)
STRIPE_PRICE_ID=
# A dónde vuelve el usuario tras pagar o cancelar (por ejemplo tu bot)
STRIPE_SUCCESS_URL=https://t.me/TU_BOT
STRIPE_CANCEL_URL=https://t.me/TU_BOT

# ─────────────────────────────────────────────────────────────
# Infraestructura
# ─────────────────────────────────────────────────────────────
# Puerto del servidor HTTP (health check + webhooks de Stripe)
PORT=8080

# Ruta del archivo SQLite donde se guardan usuarios y suscripciones
DATABASE_PATH=data/bot.db

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
