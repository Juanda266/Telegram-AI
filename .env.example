# ─────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────
# Token del bot de Telegram, obtenido de @BotFather
TELEGRAM_BOT_TOKEN=

# Lista opcional de IDs de usuario de Telegram autorizados a usar el bot,
# separados por comas. Si se deja vacío, cualquiera puede usarlo.
ALLOWED_TELEGRAM_USER_IDS=

# IDs de Telegram que pueden ver las estadísticas del bot con /stats
# (usuarios totales, suscriptores, uso diario). Pon aquí tu propio ID:
# puedes averiguarlo escribiéndole a @userinfobot.
ADMIN_TELEGRAM_USER_IDS=

# ─────────────────────────────────────────────────────────────
# IA (OpenRouter)
# ─────────────────────────────────────────────────────────────
# API key de OpenRouter (https://openrouter.ai/keys). Es gratuita: te
# permite usar varios modelos gratuitos ("...:free") con una sola key.
OPENROUTER_API_KEY=

# Modelos a usar, en orden de preferencia, separados por comas.
# "openrouter/free" es un router que elige solo entre los modelos gratuitos
# disponibles en cada momento, así que normalmente no hace falta tocar esto:
# además, el bot descubre por su cuenta otros modelos gratis y los usa como
# respaldo si el router falla.
# Si quieres fijar modelos concretos, míralos en
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=openrouter/free

# Cabeceras opcionales que OpenRouter usa para atribuir el tráfico
OPENROUTER_SITE_URL=https://github.com/Juanda266/Telegram-AI
OPENROUTER_APP_NAME=Telegram AI Assistant

# Cantidad de mensajes previos (por chat) que se envían como contexto al modelo
MAX_HISTORY_MESSAGES=20

# Máximo de pasos de razonamiento/búsqueda que el agente puede dar antes de
# responder (evita bucles infinitos de búsqueda)
MAX_AGENT_STEPS=6

# Peticiones por minuto que el bot hará a OpenRouter. El nivel gratuito
# permite unas 20 por minuto POR API KEY (no por usuario), así que conviene
# dejar un margen. Si superas la cuota, las peticiones esperan en vez de fallar.
OPENROUTER_REQUESTS_PER_MINUTE=18

# ─────────────────────────────────────────────────────────────
# Facturación — opcional (varios métodos combinables)
# ─────────────────────────────────────────────────────────────
# Pon BILLING_ENABLED=true para activar el plan gratuito limitado + Premium.
# Si lo dejas en false, el bot es ilimitado para todos.
BILLING_ENABLED=false

# Mensajes gratis por usuario y por día en el plan gratuito
FREE_DAILY_MESSAGES=15

# Texto que se muestra al usuario al ofrecerle el plan (solo informativo)
# Ajústalo al método y precio que uses de verdad, p. ej. "5 USD/mes"
# o "20.000 COP/mes".
PREMIUM_PRICE_LABEL=5 USD/mes

# ── Método 1: Telegram Stars (RECOMENDADO) ──────────────────────────
# Es la forma más fácil de empezar a cobrar: el usuario paga dentro de
# Telegram, no necesitas cuenta de comercio ni que Stripe opere en tu país
# (Stripe, por ejemplo, no admite cobros desde Colombia).
# Precio en Stars (0 = desactivado). Referencia: 150 Stars ≈ 2-3 USD.
TELEGRAM_STARS_PRICE=0
# true = suscripción que Telegram renueva sola cada 30 días
# false = pago único que da 30 días de Premium
TELEGRAM_STARS_SUBSCRIPTION=true

# ── Método 2: Wompi — Colombia (RECOMENDADO para cobrar allá) ───────
# Pasarela de Bancolombia. Acepta Nequi, PSE, Daviplata, botón
# Bancolombia, tarjetas y efectivo (Efecty, Baloto), que es como paga la
# mayoría de la gente en Colombia. Comisión ~2.65% + $700 + IVA.
# Regístrate en https://comercios.wompi.co y copia tus llaves.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Precio del plan, en la unidad de la moneda (20000 = $20.000 COP)
WOMPI_AMOUNT=0
WOMPI_CURRENCY=COP

# ── Método 3: PayPal ────────────────────────────────────────────────
# Útil para cobrar fuera de Colombia. Ojo: recibir dinero en Colombia
# por PayPal sale caro (comisión de recepción + cambio a pesos + retiro).
# Crea la app y el plan de suscripción en https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del plan de suscripción (empieza por P-)
PAYPAL_PLAN_ID=
# ID del webhook creado en el panel de PayPal
PAYPAL_WEBHOOK_ID=
# true para probar con el entorno de pruebas de PayPal
PAYPAL_SANDBOX=false

# A dónde vuelve el usuario tras pagar (por ejemplo, tu bot)
PAYMENT_RETURN_URL=https://t.me/TU_BOT

# ── Método 4: Stripe (opcional) ─────────────────────────────────────

# Credenciales de Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhooks (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=
# ID del precio recurrente creado en Stripe (empieza por price_...)
STRIPE_PRICE_ID=
# A dónde vuelve el usuario tras pagar o cancelar (por ejemplo tu bot)
STRIPE_SUCCESS_URL=https://t.me/TU_BOT
STRIPE_CANCEL_URL=https://t.me/TU_BOT

# ─────────────────────────────────────────────────────────────
# Infraestructura
# ─────────────────────────────────────────────────────────────
# Puerto del servidor HTTP (health check + webhooks de las pasarelas)
PORT=8080

# Ruta del archivo SQLite donde se guardan usuarios y suscripciones
DATABASE_PATH=data/bot.db

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
